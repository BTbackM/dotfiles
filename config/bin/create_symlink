#!/bin/bash

set -e

if [[ $# -ne 2 ]]; then
    echo "Usage: $0 <target> <link>" >&2
    exit 1
fi

target=$1
link=$2

if [[ "$target" != /* ]]; then
    target="$PWD/$target"
fi
if [[ "$link" != /* ]]; then
    link="$PWD/$link"
fi

if [[ -d "$link" ]]; then
    link="$link/$(basename -- "$target")"
fi

parent=$(dirname -- "$link")

mkdir -p -- "$parent"
if [[ -e "$link" || -L "$link" ]]; then
    rm -f -- "$link"
fi

ln -sf -- "$target" "$link"
