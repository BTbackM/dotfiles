export CONFIG_PATH=$HOME/.dotfiles/config/

# ZSH
export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="robbyrussell"

plugins=(git dotenv docker docker-compose kubectl)
source $ZSH/oh-my-zsh.sh

source "$CONFIG_PATH/zsh/zshrc.path"
source "$CONFIG_PATH/zsh/zshrc.alias"
source "$CONFIG_PATH/zsh/zshrc.dev"
typeset -U path

export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"

source <(fzf --zsh)
